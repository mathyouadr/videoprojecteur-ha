[Unit]
Description=Page d'accueil du vidéoprojecteur
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/accueil-projecteur.env
ExecStart=/usr/bin/python3 /opt/accueil-projecteur/server.py
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
